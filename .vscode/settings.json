{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "chat.tools.terminal.terminalProfile.linux": {
    "path": "/bin/bash"
  },
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "always"
  },
  "biome.enabled": false,
  "editor.tabSize": 2,
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
